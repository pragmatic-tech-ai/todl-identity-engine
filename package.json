{
  "name": "@pragmatic-tech-ai/pragmatic-identity-engine-binding",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/pragmatic-tech-ai/todl-identity-engine.git"
  },
  "description": "Bridge engine binding the TODL security model to the pragmatic-identity authorization model: security vocabulary mapping and tier-1 access-depth, membership and field-security evaluation.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "@pragmatic-tech-ai/todl-runtime": "^0.7.0"
  },
  "dependencies": {
    "@pragmatic-tech-ai/pragmatic-graph": "file:../pragmatic-graph",
    "@pragmatic-tech-ai/pragmatic-identity": "file:../pragmatic-shared/packages/pragmatic-identity"
  },
  "peerDependencies": {
    "@pragmatic-tech-ai/todl": "^0.66.2"
  }
}
